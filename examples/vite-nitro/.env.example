# This example serves both Vite and Nitro on one origin. Keep /api/auth here.
BETTER_AUTH_URL=http://localhost:3000/api/auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Your Discourse identity provider's site root and shared DiscourseConnect secret.
DISCOURSE_URL=https://community.example.com
DISCOURSE_CONNECT_SECRET=

# Relative to examples/vite-nitro when using the provided scripts.
SQLITE_PATH=./data/auth.sqlite

# Explicitly opt into trusting Discourse for account linking. See README.md.
DISCOURSE_TRUST_FOR_LINKING=false
