{
  "name": "better-auth-discourse",
  "version": "0.1.0",
  "description": "DiscourseConnect authentication plugin for Better Auth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldbeybladeorg/better-auth-discourse.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:dev": "pnpm build && pnpm --dir examples/vite-nitro dev",
    "example:migrate": "pnpm build && pnpm --dir examples/vite-nitro db:migrate",
    "example:build": "pnpm build && pnpm --dir examples/vite-nitro build",
    "validate:package": "pnpm build && node scripts/validate-package.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "better-auth": "^1.7.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "better-auth": "1.7.18",
    "esbuild": "^0.25.12",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "tsdown": "^0.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
